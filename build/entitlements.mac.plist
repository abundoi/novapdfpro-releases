<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime Security Entitlements for NovaPDFPro macOS -->
    <!-- Allows V8 JIT code generation strictly required by JavaScript/Wasm engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Prohibits executing memory that is not digitally signed -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>

    <!-- Blocks DYLD environment injection attacks (anti-tamper / anti-hijack) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- Enforces strict dynamic library validation against Apple Developer ID -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <!-- Sandboxed File System Access: Only files explicitly chosen by user via Open/Save dialogs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Blocks microphone, camera, and location access -->
    <key>com.apple.security.device.camera</key>
    <false/>
    <key>com.apple.security.device.microphone</key>
    <false/>
    <key>com.apple.security.personal-information.location</key>
    <false/>
</dict>
</plist>
